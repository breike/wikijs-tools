[Unit]
Description=Wiki.js calendar publisher (cal-<year>, cal-<year>-week-<week>)
Documentation=https://docs.js.wiki/dev/api
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Бинарник из Arch-пакета (PKGBUILD) — /usr/bin/wiki-calendar;
# install.sh ставит туда же.
ExecStart=/usr/bin/wiki-calendar

# Переменные окружения — в /etc/wiki-calendar.env (редактируй там).
# Файл объявлен в backup=() PKGBUILD: pacman не затирает его при
# переустановке/обновлении, а правится один раз и не требует повторных правок.
EnvironmentFile=/etc/wiki-calendar.env

# Перезапуск при сбое, с задержкой
Restart=on-failure
RestartSec=10

# Логи — в journald (journalctl -u wiki-calendar)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target