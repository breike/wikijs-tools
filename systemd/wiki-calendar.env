# wiki-calendar.env — переменные окружения для сервиса wiki-calendar.
#
# Читается systemd-юнитом через EnvironmentFile. Формат: KEY=VALUE (без кавычек).
# Изменённые значения СОХРАНЯЮТСЯ при переустановке пакета: файл объявлен
# в backup=() PKGBUILD, и pacman не перезаписывает изменённый конфиг
# (обновлённая версия ложится рядом как /etc/wiki-calendar.env.pacnew).
#
# После правок:  sudo systemctl restart wiki-calendar

# URL вашей Wiki.js (без завершающего слэша)
WIKI_HOST=https://wiki.example.com

# Токен API: системный ключ или личный токен со scope "pages".
# Создать: Wiki.js -> Administration -> API keys
WIKI_TOKEN=PASTE_YOUR_TOKEN_HERE

# Как часто проверять, сек. Пишет на страницу только при реальном изменении
# (смена дня/часа), поэтому частый опрос не плодит версии.
WIKI_REFRESH_INTERVAL_S=60

# UUID сайта; пусто = авто-определение через GET /_api/bootstrap
WIKI_SITE_ID=

# Локаль страниц; пусто = локаль сайта по умолчанию
WIKI_LOCALE=

# Логировать действия в journal (1/0)
WIKI_VERBOSE=1